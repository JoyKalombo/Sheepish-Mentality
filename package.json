  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
