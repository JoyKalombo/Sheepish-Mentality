{
  "name": "sheepish-mentality",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build && node server/prepare-model.js",
